# Public portfolio — environment variables (Vercel → this project → Settings → Environment Variables)
# Same values as the OS project for the first two.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Full public address of this site, no trailing slash (used in links, sitemap and social cards)
SITE_URL=https://personal-os-portfolio.vercel.app
# A long random string. The SAME value goes in the OS project as PORTFOLIO_REVALIDATE_SECRET.
PORTFOLIO_REVALIDATE_SECRET=
# 1 = tell search engines not to index the site (keep until you go live), empty = indexable
ROBOTS_NOINDEX=1

# ——— Contact form (Phase 6). Without all of these the Contact page says the form is not available yet. ———
# Cloudflare Turnstile: site key (public) and secret key. Create a widget at https://dash.cloudflare.com → Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Address of the OS (where messages are delivered), no trailing slash. Example: https://your-os.vercel.app
PORTFOLIO_OS_URL=
